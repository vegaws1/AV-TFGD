# ============================ PERFORMANCE-OPTIMIZED TRAINER ============================
class PerformanceTrainer:
    def __init__(self, model, optimizer, criterion, device):
        self.model = model
        self.optimizer = optimizer
        self.criterion = criterion
        self.device = device
        self.train_losses = []
        self.val_losses = []
        self.val_accuracies = []
        self.best_accuracy = 0.0

    def train_epoch(self, train_loader):
        self.model.train()
        total_loss = 0.0
        correct = 0
        total_samples = 0
        
        for data, targets in train_loader:
            data, targets = data.to(self.device), targets.to(self.device)
            self.optimizer.zero_grad()
            outputs = self.model(data)
            loss = self.criterion(outputs, targets)
            loss.backward()
            self.optimizer.step()

            total_loss += loss.item() * data.size(0)
            _, predicted = torch.max(outputs.data, 1)
            correct += (predicted == targets).sum().item()
            total_samples += data.size(0)

        epoch_loss = total_loss / total_samples
        epoch_accuracy = 100.0 * correct / total_samples
        return epoch_loss, epoch_accuracy

    def validate(self, val_loader):
        self.model.eval()
        total_loss = 0.0
        correct = 0
        total_samples = 0
        with torch.no_grad():
            for data, targets in val_loader:
                data, targets = data.to(self.device), targets.to(self.device)
                outputs = self.model(data)
                loss = self.criterion(outputs, targets)
                total_loss += loss.item() * data.size(0)
                _, predicted = torch.max(outputs.data, 1)
                correct += (predicted == targets).sum().item()
                total_samples += data.size(0)

        val_loss = total_loss / total_samples
        val_accuracy = 100.0 * correct / total_samples
        return val_loss, val_accuracy

    def train(self, train_loader, val_loader, epochs, patience=20):
        best_val_loss = float('inf')
        patience_counter = 0
        best_epoch = 0

        for epoch in range(epochs):
            train_loss, train_acc = self.train_epoch(train_loader)
            val_loss, val_acc = self.validate(val_loader)

            # Update optimizer with validation loss
            if hasattr(self.optimizer, 'update_epoch'):
                self.optimizer.update_epoch(val_loss)

            self.train_losses.append(train_loss)
            self.val_losses.append(val_loss)
            self.val_accuracies.append(val_acc)

            # Track best accuracy
            if val_acc > self.best_accuracy:
                self.best_accuracy = val_acc

            # Performance-focused debugging
            if hasattr(self.optimizer, 'get_adaptation_stats'):
                stats = self.optimizer.get_adaptation_stats()
                if stats and epoch % 5 == 0:
                    print(f'[Performance] Epoch {epoch+1:03d}: λ: {stats["current_lam"]:.3f}, '
                          f'Acc: {val_acc:.2f}%')

            print(f'Epoch {epoch+1:03d}/{epochs}: '
                  f'Train Loss: {train_loss:.4f}, Train Acc: {train_acc:.2f}% '
                  f'| Val Loss: {val_loss:.4f}, Val Acc: {val_acc:.2f}%')

            # Early stopping with performance focus
            if val_loss < best_val_loss:
                best_val_loss = val_loss
                patience_counter = 0
                best_epoch = epoch
                best_model_state = self.model.state_dict().copy()
            else:
                patience_counter += 1
                if patience_counter >= patience:
                    print(f'Early stopping at epoch {epoch+1}')
                    break

        # Restore best model
        if 'best_model_state' in locals():
            self.model.load_state_dict(best_model_state)

        return best_val_loss, best_epoch

