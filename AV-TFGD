# ============================ CHAMPION VA-TFGD OPTIMIZER ============================
class VATFGD_Champion(Optimizer):
    """
    CHAMPION VA-TFGD - Optimized for maximum performance
    """
    def __init__(self, params, lr=1e-2, alpha=0.7, lam_min=0.08, lam_max=0.35,
                 base_lam=0.15, adapt_gain=0.25, variance_window=25, 
                 smoothing_factor=0.98, weight_decay=0.0, warmup_epochs=20,
                 grad_clip=1.2, var_clip=2.0, performance_mode=True):
        
        if lr <= 0:
            raise ValueError("Invalid learning rate")
        if not (0 < alpha < 1):
            raise ValueError("Alpha must be in (0,1)")
        if lam_min <= 0 or lam_max <= 0 or lam_min > lam_max:
            raise ValueError("Require 0 < lam_min <= lam_max")

        defaults = dict(lr=lr, alpha=alpha, lam_min=lam_min, lam_max=lam_max,
                       base_lam=base_lam, adapt_gain=adapt_gain, 
                       variance_window=variance_window, smoothing_factor=smoothing_factor,
                       weight_decay=weight_decay, warmup_epochs=warmup_epochs,
                       grad_clip=grad_clip, var_clip=var_clip, performance_mode=performance_mode)
        super().__init__(params, defaults)

        # State variables
        self.current_lam = base_lam
        self.ema_grad_norm = 0.0
        self.variance_buffer = []
        self.grad_history = []
        self.lam_history = []
        self.grad_variance_history = []
        self.step_count = 0
        self.epoch_count = 0
        self.best_val_loss = float('inf')
        self.patience_counter = 0
        self.performance_mode = performance_mode

    @torch.no_grad()
    def step(self, closure=None):
        loss = None
        if closure is not None:
            with torch.enable_grad():
                loss = closure()
        
        self.step_count += 1

        # Compute gradient statistics with performance-oriented clipping
        grad_norms = []
        for group in self.param_groups:
            for p in group['params']:
                if p.grad is not None:
                    grad_norm = p.grad.norm().item()
                    # Performance-oriented gradient clipping
                    if grad_norm > group['grad_clip']:
                        p.grad.data.mul_(group['grad_clip'] / (grad_norm + 1e-8))
                        grad_norm = group['grad_clip']
                    grad_norms.append(grad_norm)
        
        if grad_norms:
            current_grad_norm = np.mean(grad_norms)  # Use mean for performance
            self.grad_history.append(current_grad_norm)
            
            # Balanced EMA update
            if self.ema_grad_norm == 0:
                self.ema_grad_norm = current_grad_norm
            else:
                self.ema_grad_norm = (0.95 * self.ema_grad_norm + 
                                    0.05 * current_grad_norm)

        # PERFORMANCE-OPTIMIZED ADAPTATION
        if len(self.grad_history) >= 10:  # Shorter warm-up for faster adaptation
            window = min(len(self.grad_history), self.defaults['variance_window'])
            recent_grads = self.grad_history[-window:]
            
            # Performance-optimized variance computation
            if len(recent_grads) > 5:
                # Simple but effective variance measure for performance
                mean_grad = np.mean(recent_grads)
                if mean_grad > 1e-8:
                    # Coefficient of variation for scale invariance
                    grad_variance = (np.std(recent_grads) / mean_grad) ** 2
                else:
                    grad_variance = 0.0
                
                # Moderate variance clipping
                grad_variance = min(grad_variance, self.defaults['var_clip'])
            else:
                grad_variance = 0.0
                
            self.grad_variance_history.append(grad_variance)
            self.variance_buffer.append(grad_variance)
            
            # Moderate buffer size
            if len(self.variance_buffer) > 20:
                self.variance_buffer.pop(0)
            
            for group in self.param_groups:
                lam_min = group['lam_min']
                lam_max = group['lam_max']
                base_lam = group['base_lam']
                adapt_gain = group['adapt_gain']
                smoothing_factor = group['smoothing_factor']
                warmup_epochs = group['warmup_epochs']
                performance_mode = group['performance_mode']

                # Performance-optimized gain adjustment
                if self.epoch_count < warmup_epochs:
                    current_gain = adapt_gain * 0.6
                else:
                    current_gain = adapt_gain

                # Use simple moving average for performance
                if len(self.variance_buffer) >= 8:
                    avg_variance = np.mean(self.variance_buffer[-8:])
                else:
                    avg_variance = grad_variance
                
                # Performance-optimized adaptation
                if performance_mode:
                    # More responsive adaptation for better performance
                    lambda_adjustment = current_gain * np.tanh(avg_variance * 1.5)
                else:
                    lambda_adjustment = current_gain * np.tanh(avg_variance * 1.0)
                
                # Target lambda with performance focus
                target_lam = base_lam + (lam_max - lam_min) * lambda_adjustment
                
                # Balanced smoothing
                new_lam = (smoothing_factor * self.current_lam + 
                          (1 - smoothing_factor) * target_lam)
                
                # Enforce bounds
                new_lam = max(lam_min, min(lam_max, new_lam))
                self.current_lam = new_lam
                
                self.lam_history.append(self.current_lam)
                beta_t = math.exp(-self.current_lam)

                # Update parameters with performance focus
                for p in group['params']:
                    if p.grad is None:
                        continue
                    g = p.grad.data
                    
                    wd = group.get('weight_decay', 0.0)
                    if wd != 0:
                        g = g.add(p.data, alpha=wd)

                    state = self.state[p]
                    if 'v' not in state:
                        state['v'] = torch.zeros_like(p.data)
                    v = state['v']
                    
                    # Standard EMA update
                    v.mul_(beta_t).add_(g)
                    p.data.add_(v, alpha=-group['lr'])

        else:
            # Warm-up period
            self.current_lam = self.defaults['base_lam']
            self.lam_history.append(self.current_lam)
            beta_t = math.exp(-self.current_lam)
            
            for group in self.param_groups:
                for p in group['params']:
                    if p.grad is None:
                        continue
                    g = p.grad.data
                    wd = group.get('weight_decay', 0.0)
                    if wd != 0:
                        g = g.add(p.data, alpha=wd)
                    state = self.state[p]
                    if 'v' not in state:
                        state['v'] = torch.zeros_like(p.data)
                    v = state['v']
                    v.mul_(beta_t).add_(g)
                    p.data.add_(v, alpha=-group['lr'])
        
        return loss

    def update_epoch(self, val_loss=None):
        """Update epoch counter and track validation loss"""
        self.epoch_count += 1
        
        if val_loss is not None:
            if val_loss < self.best_val_loss:
                self.best_val_loss = val_loss
                self.patience_counter = 0
            else:
                self.patience_counter += 1

    def get_adaptation_stats(self):
        """Get adaptation statistics"""
        if len(self.grad_variance_history) > 10 and len(self.lam_history) > 10:
            min_len = min(len(self.grad_variance_history), len(self.lam_history))
            var_aligned = self.grad_variance_history[:min_len]
            lam_aligned = self.lam_history[:min_len]
            
            correlation = np.corrcoef(var_aligned, lam_aligned)[0,1] if min_len > 1 else 0
            
            return {
                'current_lam': self.current_lam,
                'current_variance': self.grad_variance_history[-1] if self.grad_variance_history else 0,
                'correlation': correlation,
                'patience_counter': self.patience_counter
            }
        return None

