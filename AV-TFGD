# ============================ UTILITIES ============================

def set_seed(seed: int = 42):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)


def get_device() -> torch.device:
    return torch.device('cuda' if torch.cuda.is_available() else 'cpu')


def ensure_dir(path: str):
    os.makedirs(path, exist_ok=True)


def clip(x: float, lo: float, hi: float) -> float:
    return max(lo, min(hi, x))


def gl_coeffs(alpha: float, K: int) -> np.ndarray:
    """Nonnegative GL coefficients: c_k^(alpha) = (alpha)_k/k!."""
    c = np.zeros(K + 1, dtype=np.float64)
    c[0] = 1.0
    for k in range(1, K + 1):
        c[k] = c[k - 1] * (alpha + k - 1) / k
    return c


# ============================ OPTIMIZERS ============================

class VATFGD_Champion(Optimizer):
    r"""VA‑TFGD champion variant (theory-aligned).

    Logs:
      - lam_history: lambda_t per step
      - g2_history: ||g_t||^2 per step
      - lam_target_history: lambda_target per step (after warmup)
    """

    def __init__(
        self,
        params,
        lr=0.015,
        alpha=0.7,
        lam_min=0.08,
        lam_max=0.35,
        base_lam=0.15,
        adapt_gain=0.25,
        variance_window=20,
        smoothing_factor=0.98,
        warmup_epochs=15,
        weight_decay=0.0,
        mode: str = 'ema',
        c_trunc: float = 5.0,
        grad_clip: Optional[float] = 1.0,
    ):
        if lr <= 0:
            raise ValueError('lr must be > 0')
        if not (0.0 < alpha < 1.0):
            raise ValueError('alpha must be in (0,1)')
        if lam_min <= 0 or lam_min > lam_max:
            raise ValueError('Need 0 < lam_min <= lam_max')
        if not (0.0 < smoothing_factor < 1.0):
            raise ValueError('smoothing_factor (tau) must be in (0,1)')
        if mode not in ('ema', 'gl'):
            raise ValueError("mode must be 'ema' or 'gl'")

        defaults = dict(
            lr=lr, alpha=alpha,
            lam_min=lam_min, lam_max=lam_max,
            base_lam=base_lam,
            adapt_gain=adapt_gain,
            variance_window=variance_window,
            smoothing_factor=smoothing_factor,
            warmup_epochs=warmup_epochs,
            weight_decay=weight_decay,
            mode=mode,
            c_trunc=c_trunc,
            grad_clip=grad_clip,
        )
        super().__init__(params, defaults)

        self.current_lam = float(base_lam)
        self.prev_lam = float(base_lam)
        self.q = 0.0
        self.epoch_count = 0

        self.lam_history: List[float] = []
        self.g2_history: List[float] = []
        self.lam_target_history: List[float] = []
        self.q_history: List[float] = []
        self.v_buffer: List[float] = []

    def update_epoch(self, val_loss=None):
        self.epoch_count += 1

    def _global_grad_norm2(self) -> float:
        s = 0.0
        for group in self.param_groups:
            for p in group['params']:
                if p.grad is None:
                    continue
                g = p.grad.data
                s += float(torch.sum(g * g).item())
        return float(s)

    @torch.no_grad()
    def step(self, closure=None):
        loss = None
        if closure is not None:
            with torch.enable_grad():
                loss = closure()

        warmup_epochs = self.defaults['warmup_epochs']
        tau = self.defaults['smoothing_factor']
        lam_min = self.defaults['lam_min']
        lam_max = self.defaults['lam_max']
        base_lam = self.defaults['base_lam']
        c_gain = self.defaults['adapt_gain']
        W = self.defaults['variance_window']
        mode = self.defaults['mode']
        c_trunc = self.defaults['c_trunc']
        grad_clip = self.defaults.get('grad_clip', None)

        # Compute ||g_t||^2
        g_norm2 = self._global_grad_norm2()
        self.g2_history.append(g_norm2)

        # q_t update (EMA)
        self.q = tau * self.q + (1.0 - tau) * g_norm2
        self.q_history.append(self.q)

        # buffer update
        self.v_buffer.append(g_norm2)
        if len(self.v_buffer) > W:
            self.v_buffer.pop(0)

        # lambda update
        if self.epoch_count < warmup_epochs:
            self.current_lam = base_lam
            self.lam_target_history.append(float('nan'))
        else:
            bar_v = float(np.mean(self.v_buffer)) if len(self.v_buffer) else 0.0
            lam_target = base_lam + c_gain * math.tanh(bar_v)
            self.lam_target_history.append(lam_target)
            self.current_lam = tau * self.prev_lam + (1.0 - tau) * lam_target
            self.current_lam = clip(self.current_lam, lam_min, lam_max)

        self.prev_lam = self.current_lam
        self.lam_history.append(self.current_lam)

        beta_t = math.exp(-self.current_lam)

        for group in self.param_groups:
            lr = group['lr']
            alpha = group['alpha']
            wd = group.get('weight_decay', 0.0)

            if mode == 'ema':
                for p in group['params']:
                    if p.grad is None:
                        continue
                    g = p.grad.data
                    if grad_clip is not None:
                        gn = g.norm().item()
                        if gn > grad_clip:
                            g = g * (grad_clip / (gn + 1e-12))
                    if wd != 0.0:
                        g = g.add(p.data, alpha=wd)
                    st = self.state[p]
                    if 'v' not in st:
                        st['v'] = torch.zeros_like(p.data)
                    v = st['v']
                    v.mul_(beta_t).add_(g)
                    p.data.add_(v, alpha=-lr)

            else:  # mode == 'gl'
                # Windowed GL sum so alpha affects weights
                K = int(math.ceil(c_trunc / max(self.current_lam, 1e-12)))
                coeffs = gl_coeffs(alpha, K)
                w_np = coeffs * np.exp(-self.current_lam * np.arange(K + 1))
                w = torch.tensor(w_np, dtype=torch.float32, device=group['params'][0].device)

                for p in group['params']:
                    if p.grad is None:
                        continue
                    g = p.grad.data
                    if grad_clip is not None:
                        gn = g.norm().item()
                        if gn > grad_clip:
                            g = g * (grad_clip / (gn + 1e-12))
                    if wd != 0.0:
                        g = g.add(p.data, alpha=wd)

                    st = self.state[p]
                    if 'ghist' not in st:
                        st['ghist'] = []
                    hist: List[torch.Tensor] = st['ghist']
                    hist.insert(0, g.clone())
                    if len(hist) > K + 1:
                        hist.pop(-1)

                    phi = torch.zeros_like(g)
                    for k, gk in enumerate(hist):
                        phi.add_(gk, alpha=float(w[k]))
                    p.data.add_(phi, alpha=-lr)

        return loss


class TFGD_Fixed(Optimizer):
    """Fixed tempering TFGD (EMA baseline): v_t = g_t + exp(-lam)*v_{t-1}."""

    def __init__(self, params, lr=0.01, lam=0.1, weight_decay=0.0, grad_clip: Optional[float] = 1.0):
        if lam <= 0:
            raise ValueError('lam must be > 0')
        defaults = dict(lr=lr, lam=lam, weight_decay=weight_decay, grad_clip=grad_clip)
        super().__init__(params, defaults)

    @torch.no_grad()
    def step(self, closure=None):
        loss = None
        if closure is not None:
            with torch.enable_grad():
                loss = closure()

        for group in self.param_groups:
            lr = group['lr']
            lam = group['lam']
            wd = group.get('weight_decay', 0.0)
            gc = group.get('grad_clip', None)
            beta = math.exp(-lam)

            for p in group['params']:
                if p.grad is None:
                    continue
                g = p.grad.data
                if gc is not None:
                    gn = g.norm().item()
                    if gn > gc:
                        g = g * (gc / (gn + 1e-12))
                if wd != 0.0:
                    g = g.add(p.data, alpha=wd)
                st = self.state[p]
                if 'v' not in st:
                    st['v'] = torch.zeros_like(p.data)
                v = st['v']
                v.mul_(beta).add_(g)
                p.data.add_(v, alpha=-lr)

        return loss


# ============================ MODEL ============================

class MLPClassifier(nn.Module):
    def __init__(self, input_dim: int, hidden_dims: List[int], output_dim: int):
        super().__init__()
        layers = []
        prev = input_dim
        for h in hidden_dims:
            layers += [nn.Linear(prev, h), nn.ReLU(inplace=True)]
            prev = h
        layers.append(nn.Linear(prev, output_dim))
        self.net = nn.Sequential(*layers)

    def forward(self, x):
        return self.net(x)


# ============================ DATA ============================

def stratified_split_indices(X: np.ndarray, y: np.ndarray, split: Tuple[float, float, float], seed: int):
    train_frac, val_frac, test_frac = split
    sss = StratifiedShuffleSplit(n_splits=1, test_size=(val_frac + test_frac), random_state=seed)
    train_idx, tmp_idx = next(sss.split(X, y))

    Xtmp, ytmp = X[tmp_idx], y[tmp_idx]
    sss2 = StratifiedShuffleSplit(n_splits=1, test_size=(test_frac / (val_frac + test_frac)), random_state=seed)
    val_rel, test_rel = next(sss2.split(Xtmp, ytmp))

    val_idx = tmp_idx[val_rel]
    test_idx = tmp_idx[test_rel]
    return train_idx, val_idx, test_idx


def load_breast_cancer_data(split=(0.8, 0.1, 0.1), seed=42, batch_size=32):
    data = load_breast_cancer()
    X, y = data.data.astype(np.float32), data.target.astype(np.int64)

    tr, va, te = stratified_split_indices(X, y, split, seed)

    scaler = StandardScaler().fit(X[tr])
    Xtr, Xva, Xte = scaler.transform(X[tr]), scaler.transform(X[va]), scaler.transform(X[te])

    tr_ds = torch.utils.data.TensorDataset(torch.tensor(Xtr), torch.tensor(y[tr]))
    va_ds = torch.utils.data.TensorDataset(torch.tensor(Xva), torch.tensor(y[va]))
    te_ds = torch.utils.data.TensorDataset(torch.tensor(Xte), torch.tensor(y[te]))

    tr_loader = torch.utils.data.DataLoader(tr_ds, batch_size=batch_size, shuffle=True)
    va_loader = torch.utils.data.DataLoader(va_ds, batch_size=batch_size, shuffle=False)
    te_loader = torch.utils.data.DataLoader(te_ds, batch_size=batch_size, shuffle=False)

    return tr_loader, va_loader, te_loader


# ============================ TRAINING ============================

@dataclass
class RunRow:
    optimizer: str
    seed: int
    acc: float
    f1: float
    auc: float
    loss: float
    lam_min: float
    lam_max: float


def epoch_metrics(model, loader, criterion, device):
    model.eval()
    total_loss = 0.0
    total = 0
    correct = 0
    y_true, y_pred, probs = [], [], []

    with torch.no_grad():
        for x, y in loader:
            x, y = x.to(device), y.to(device)
            out = model(x)
            loss = criterion(out, y)
            total_loss += loss.item() * x.size(0)
            total += x.size(0)
            pred = out.argmax(1)
            correct += pred.eq(y).sum().item()
            y_true.extend(y.detach().cpu().numpy().tolist())
            y_pred.extend(pred.detach().cpu().numpy().tolist())
            probs.extend(F.softmax(out, dim=1)[:, 1].detach().cpu().numpy().tolist())

    avg_loss = total_loss / max(total, 1)
    acc = correct / max(total, 1)
    f1 = f1_score(y_true, y_pred, average='weighted')
    auc = roc_auc_score(y_true, probs) if len(set(y_true)) == 2 else float('nan')
    return float(avg_loss), float(acc), float(f1), float(auc)


def train_one_run(model, optimizer, train_loader, val_loader, test_loader, device,
                  epochs=200, patience=25, optimizer_name=''):
    criterion = nn.CrossEntropyLoss()
    best_val = float('inf')
    best_state = None
    wait = 0

    history = []  # epoch-wise

    for epoch in range(1, epochs + 1):
        model.train()
        train_loss_sum = 0.0
        train_total = 0
        train_correct = 0

        for x, y in train_loader:
            x, y = x.to(device), y.to(device)
            optimizer.zero_grad()
            out = model(x)
            loss = criterion(out, y)
            loss.backward()
            optimizer.step()

            train_loss_sum += loss.item() * x.size(0)
            train_total += x.size(0)
            train_correct += out.argmax(1).eq(y).sum().item()

        train_loss = train_loss_sum / max(train_total, 1)
        train_acc = train_correct / max(train_total, 1)

        val_loss, val_acc, _, _ = epoch_metrics(model, val_loader, criterion, device)

        # inform optimizer about epoch boundary (warmup control)
        if hasattr(optimizer, 'update_epoch'):
            optimizer.update_epoch(val_loss)

        history.append({
            'epoch': epoch,
            'train_loss': float(train_loss),
            'train_acc': float(train_acc),
            'val_loss': float(val_loss),
            'val_acc': float(val_acc),
        })

        if val_loss < best_val - 1e-6:
            best_val = val_loss
            wait = 0
            best_state = {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}
        else:
            wait += 1
            if wait >= patience:
                break

    if best_state is not None:
        model.load_state_dict(best_state)

    test_loss, test_acc, test_f1, test_auc = epoch_metrics(model, test_loader, criterion, device)

    lam_hist = getattr(optimizer, 'lam_history', [])
    lam_min = float(np.min(lam_hist)) if len(lam_hist) else float('nan')
    lam_max = float(np.max(lam_hist)) if len(lam_hist) else float('nan')

    return (test_loss, test_acc, test_f1, test_auc, lam_min, lam_max, history)


# ============================ VISUALIZATION ============================

def plot_bar_with_error(df_summary: pd.DataFrame, metric: str, out_path: str, title: str, ylabel: str):
    import matplotlib.pyplot as plt

    # expect columns like acc_mean, acc_std
    m = f'{metric}_mean'
    s = f'{metric}_std'
    order = list(df_summary['optimizer'].values)

    y = df_summary[m].values
    e = df_summary[s].values

    plt.figure(figsize=(8.8, 4.2))
    plt.bar(order, y, yerr=e, capsize=4)
    plt.xticks(rotation=20, ha='right')
    plt.ylabel(ylabel)
    plt.title(title)
    plt.tight_layout()
    plt.savefig(out_path, dpi=220)
    plt.close()


def plot_val_loss_curves(curves_df: pd.DataFrame, out_path: str):
    import matplotlib.pyplot as plt

    plt.figure(figsize=(8.8, 4.6))
    for opt in curves_df['optimizer'].unique():
        sub = curves_df[curves_df['optimizer'] == opt]
        # compute mean and std over seeds for each epoch
        grp = sub.groupby('epoch')['val_loss']
        mean = grp.mean()
        std = grp.std()
        x = mean.index.values
        plt.plot(x, mean.values, label=opt)
        plt.fill_between(x, (mean - std).values, (mean + std).values, alpha=0.15)

    plt.xlabel('Epoch')
    plt.ylabel('Validation loss')
    plt.title('Validation loss vs epoch (mean ± std over seeds)')
    plt.grid(True, alpha=0.3)
    plt.legend()
    plt.tight_layout()
    plt.savefig(out_path, dpi=220)
    plt.close()


def plot_lambda_evolution(lam_files: List[str], out_path: str):
    import matplotlib.pyplot as plt

    plt.figure(figsize=(9.2, 4.2))
    for f in lam_files:
        df = pd.read_csv(f)
        plt.plot(df['step'].values, df['lambda'].values, alpha=0.85, linewidth=1.6,
                 label=f"seed={int(df['seed'].iloc[0])}")

    plt.xlabel('Step')
    plt.ylabel(r'$\lambda_t$')
    plt.title(r'VA-TFGD: $\lambda_t$ evolution (per seed)')
    plt.grid(True, alpha=0.3)
    plt.legend(ncol=3, fontsize=9)
    plt.tight_layout()
    plt.savefig(out_path, dpi=220)
    plt.close()


def plot_lambda_vs_gradnorm2(lam_files: List[str], out_path: str):
    import matplotlib.pyplot as plt

    plt.figure(figsize=(7.2, 5.2))
    for f in lam_files:
        df = pd.read_csv(f)
        # scatter a subsample for readability
        step = df['step'].values
        lam = df['lambda'].values
        g2 = df['g_norm2'].values
        if len(step) > 1200:
            idx = np.linspace(0, len(step) - 1, 1200).astype(int)
            lam = lam[idx]
            g2 = g2[idx]
        plt.scatter(g2, lam, s=8, alpha=0.35, label=f"seed={int(df['seed'].iloc[0])}")

    plt.xlabel(r'$\|g_t\|^2$')
    plt.ylabel(r'$\lambda_t$')
    plt.title(r'VA-TFGD: relation between $\|g_t\|^2$ and $\lambda_t$')
    plt.grid(True, alpha=0.3)
    plt.legend(ncol=2, fontsize=9)
    plt.tight_layout()
    plt.savefig(out_path, dpi=220)
    plt.close()


# ============================ MAIN ============================

def main():
    ap = argparse.ArgumentParser()

    ap.add_argument('--split', default='80/10/10', choices=['80/10/10', '70/15/15'])
    ap.add_argument('--seeds', default='42,43,44,45,46')
    ap.add_argument('--out_dir', default='results_bc')

    ap.add_argument('--epochs', type=int, default=200)
    ap.add_argument('--patience', type=int, default=25)
    ap.add_argument('--batch_size', type=int, default=32)

    # VA-TFGD (Champion) hyperparameters (theory-aligned)
    ap.add_argument('--lr_va', type=float, default=0.015)
    ap.add_argument('--alpha', type=float, default=0.7)
    ap.add_argument('--lam_min', type=float, default=0.08)
    ap.add_argument('--lam_max', type=float, default=0.35)
    ap.add_argument('--base_lam', type=float, default=0.15)
    ap.add_argument('--adapt_gain', type=float, default=0.25)
    ap.add_argument('--W', type=int, default=20)
    ap.add_argument('--tau', type=float, default=0.98)
    ap.add_argument('--warmup_epochs', type=int, default=15)
    ap.add_argument('--mode', default='ema', choices=['ema', 'gl'])
    ap.add_argument('--c_trunc', type=float, default=5.0)
    ap.add_argument('--grad_clip', type=float, default=1.0)

    # baseline learning rates / params
    ap.add_argument('--lr_sgd', type=float, default=0.01)
    ap.add_argument('--lr_adam', type=float, default=0.01)
    ap.add_argument('--lr_sgdm', type=float, default=0.01)
    ap.add_argument('--momentum', type=float, default=0.9)
    ap.add_argument('--lam_fixed', type=float, default=0.10)

    # Colab-safe
    args, _unknown = ap.parse_known_args()

    device = get_device()
    print('Using device:', device)

    ensure_dir(args.out_dir)

    seeds = [int(s) for s in args.seeds.split(',') if s.strip()]

    split_tuple = (0.8, 0.1, 0.1) if args.split == '80/10/10' else (0.7, 0.15, 0.15)

    # define optimizers
    def make_va(params):
        return VATFGD_Champion(
            params,
            lr=args.lr_va,
            alpha=args.alpha,
            lam_min=args.lam_min,
            lam_max=args.lam_max,
            base_lam=args.base_lam,
            adapt_gain=args.adapt_gain,
            variance_window=args.W,
            smoothing_factor=args.tau,
            warmup_epochs=args.warmup_epochs,
            mode=args.mode,
            c_trunc=args.c_trunc,
            grad_clip=args.grad_clip,
        )

    optimizers: Dict[str, callable] = {
        'VA-TFGD (Champion)': make_va,
        'TFGD (Fixed)': lambda p: TFGD_Fixed(p, lr=args.lr_sgd, lam=args.lam_fixed, grad_clip=args.grad_clip),
        'SGD': lambda p: torch.optim.SGD(p, lr=args.lr_sgd),
        'SGD-M': lambda p: torch.optim.SGD(p, lr=args.lr_sgdm, momentum=args.momentum),
        'Adam': lambda p: torch.optim.Adam(p, lr=args.lr_adam),
    }

    # run experiments
    per_seed_rows: List[dict] = []
    curves_rows: List[dict] = []
    lam_files: List[str] = []

    for seed in seeds:
        set_seed(seed)
        tr_loader, va_loader, te_loader = load_breast_cancer_data(split=split_tuple, seed=seed, batch_size=args.batch_size)

        for opt_name, opt_fn in optimizers.items():
            model = MLPClassifier(30, [64, 32], 2).to(device)
            opt = opt_fn(model.parameters())

            test_loss, test_acc, test_f1, test_auc, lam_min, lam_max, history = train_one_run(
                model, opt, tr_loader, va_loader, te_loader, device,
                epochs=args.epochs, patience=args.patience, optimizer_name=opt_name
            )

            per_seed_rows.append({
                'dataset': 'BreastCancer',
                'optimizer': opt_name,
                'seed': seed,
                'acc': test_acc,
                'f1': test_f1,
                'auc': test_auc,
                'loss': test_loss,
                'lam_min': lam_min,
                'lam_max': lam_max,
            })

            for h in history:
                curves_rows.append({
                    'dataset': 'BreastCancer',
                    'optimizer': opt_name,
                    'seed': seed,
                    **h
                })

            lam_info = f'lambda=[{lam_min:.3f},{lam_max:.3f}]' if not math.isnan(lam_min) else 'lambda=[n/a]'
            print(f'BreastCancer | {opt_name} | seed={seed} | acc={test_acc:.4f} f1={test_f1:.4f} auc={test_auc:.4f} loss={test_loss:.4f} | {lam_info}')

            # save lambda history (only for VA-TFGD)
            if opt_name == 'VA-TFGD (Champion)' and hasattr(opt, 'lam_history'):
                df_lam = pd.DataFrame({
                    'seed': seed,
                    'step': np.arange(1, len(opt.lam_history) + 1),
                    'lambda': np.array(opt.lam_history, dtype=float),
                    'g_norm2': np.array(getattr(opt, 'g2_history', [np.nan] * len(opt.lam_history)), dtype=float),
                    'lambda_target': np.array(getattr(opt, 'lam_target_history', [np.nan] * len(opt.lam_history)), dtype=float),
                })
                out_lam = os.path.join(args.out_dir, f'lambda_history_seed{seed}.csv')
                df_lam.to_csv(out_lam, index=False)
                lam_files.append(out_lam)

    # save CSVs
    df_per = pd.DataFrame(per_seed_rows)
    df_per.to_csv(os.path.join(args.out_dir, 'breastcancer_per_seed.csv'), index=False)

    df_sum = df_per.groupby(['dataset', 'optimizer']).agg(
        acc_mean=('acc', 'mean'), acc_std=('acc', 'std'),
        f1_mean=('f1', 'mean'), f1_std=('f1', 'std'),
        auc_mean=('auc', 'mean'), auc_std=('auc', 'std'),
        loss_mean=('loss', 'mean'), loss_std=('loss', 'std'),
        lam_min=('lam_min', 'min'), lam_max=('lam_max', 'max')
    ).reset_index()

    df_sum.to_csv(os.path.join(args.out_dir, 'breastcancer_summary.csv'), index=False)

    df_curves = pd.DataFrame(curves_rows)
    df_curves.to_csv(os.path.join(args.out_dir, 'training_curves.csv'), index=False)

    # generate figures
    plot_bar_with_error(
        df_sum[df_sum['dataset'] == 'BreastCancer'].copy(),
        metric='acc',
        out_path=os.path.join(args.out_dir, 'fig_accuracy_bar.png'),
        title='Breast Cancer: Test accuracy (mean ± std over seeds)',
        ylabel='Accuracy'
    )
    plot_bar_with_error(
        df_sum[df_sum['dataset'] == 'BreastCancer'].copy(),
        metric='f1',
        out_path=os.path.join(args.out_dir, 'fig_f1_bar.png'),
        title='Breast Cancer: Test F1 (mean ± std over seeds)',
        ylabel='F1-score'
    )
    plot_bar_with_error(
        df_sum[df_sum['dataset'] == 'BreastCancer'].copy(),
        metric='auc',
        out_path=os.path.join(args.out_dir, 'fig_auc_bar.png'),
        title='Breast Cancer: Test AUC (mean ± std over seeds)',
        ylabel='AUC'
    )

    plot_val_loss_curves(
        df_curves[df_curves['dataset'] == 'BreastCancer'].copy(),
        out_path=os.path.join(args.out_dir, 'fig_val_loss_curves.png')
    )

    if lam_files:
        plot_lambda_evolution(lam_files, os.path.join(args.out_dir, 'fig_lambda_evolution.png'))
        plot_lambda_vs_gradnorm2(lam_files, os.path.join(args.out_dir, 'fig_lambda_vs_gradnorm2.png'))

    # print created files
    created = sorted([str(p) for p in Path(args.out_dir).glob('**/*') if p.is_file()])
    print('\nCreated files:')
    for pth in created:
        print(' -', pth)
    print('\nDone. Results + figures saved in:', args.out_dir)


if __name__ == '__main__':
    main()
